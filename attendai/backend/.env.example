# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/attendai

# --- Security ---
# Use a long random value in production:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-string
TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Attendance rules ---
# true = mark half-day/absent from hours worked (keep false while demoing)
ENFORCE_WORK_HOURS=false

# --- QR check-in ---
# How long one office QR code stays valid. The kiosk screen shows a fresh one before this runs out.
QR_TOKEN_SECONDS=45

# --- Face ID ---
# Lower is stricter. 0.5 suits office use; 0.6 is the library default and lets more people through.
FACE_MATCH_THRESHOLD=0.5

# --- Email notifications ---
# Where the links inside emails point (your frontend address).
APP_URL=http://localhost:5173
# Leave SMTP_HOST empty to print emails in the backend window instead of sending them (good for demos).
# EMAIL_ENABLED=false switches emails off completely.
EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASSWORD=<16-character app password>
